# 复制成 .env 再改，docker compose 会自动读取

# 对外端口（浏览器里访问 http://服务器IP:这个端口）
ASSETBOOK_PORT=8000

# 首次启动的登录密码（强烈建议改掉，至少 8 位）
ASSETBOOK_PASSWORD=change-me-please

# 会话签名密钥。可留空自动生成；想固定就填一串随机字符：
#   python3 -c "import secrets;print(secrets.token_hex(32))"
ASSETBOOK_SECRET=

# 可选：OpenAI 兼容接口，用于「AI 兜底分类」和「AI 财务分析」。
# 建议直接在网页「设置 → AI 分析」里填，这里只是兜底（界面里填的优先）。
# 例：ASSETBOOK_AI_BASE=https://api.deepseek.com/v1
#     ASSETBOOK_AI_MODEL=deepseek-chat
ASSETBOOK_AI_BASE=
ASSETBOOK_AI_KEY=
ASSETBOOK_AI_MODEL=

# ── 自动同步（行情 / 汇率 / 净值快照 / 账单收取）──────────────────
# 总开关，1 开 0 关。开起来后每天会自动刷现价、拉汇率、记净值快照，
# 这些设置改了也能在 界面 → 设置 → 自动同步 里随时调，数据库里的优先。
ASSETBOOK_AUTO_SYNC=1
# 行情刷新间隔（分钟），5~1440
ASSETBOOK_QUOTE_INTERVAL_MIN=30
# 每天几点记一次净值快照（0~23 点）
ASSETBOOK_SNAPSHOT_HOUR=23
# 汇率刷新间隔（小时），1~168
ASSETBOOK_RATES_INTERVAL_HOUR=12

# ── 账单自动收取（支付宝 / 微信 / 银行）────────────────────────
# 说明：这三家都没有面向个人的交易 API，账单只能靠「导出文件」或「邮箱」进来。
# 方式一（最省心）：把导出的账单文件丢进收件目录，后台定时扫描自动入库。
#   容器里默认是 /data/inbox（已挂卷，宿主机可 docker cp 进去）；
#   本地跑默认是项目目录下的 data/inbox。想换位置就填绝对路径。
ASSETBOOK_INBOX=
# 收件目录里没匹配到规则的行落到哪个账户（填账户名或 id；不填用第一个非负债账户）
ASSETBOOK_INBOX_ACCOUNT=
# 扫收件目录间隔（分钟），1~1440
ASSETBOOK_INBOX_INTERVAL_MIN=10

# 方式二：IMAP 邮箱自动收账单（支付宝/微信的账单邮件附件）。
# 只收未读邮件，处理完自动标记已读。三项 host/user/pass 都填了才会启用。
ASSETBOOK_IMAP_HOST=
ASSETBOOK_IMAP_PORT=993
ASSETBOOK_IMAP_USER=
ASSETBOOK_IMAP_PASS=
ASSETBOOK_IMAP_FOLDER=INBOX
# 0 = 不用 SSL（一般 993 端口走 SSL，保持默认即可）
ASSETBOOK_IMAP_SSL=1
# 只收某个发件人的邮件（可选，比如 bill@alipay.com）
ASSETBOOK_IMAP_FROM=
# 微信导出的 zip 是加密的，密码在微信「账单下载」的通知里，填这里可自动解开
ASSETBOOK_WECHAT_ZIP_PASSWORD=
# 收邮件间隔（分钟），5~1440
ASSETBOOK_MAIL_INTERVAL_MIN=60
