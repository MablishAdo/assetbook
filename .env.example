# 复制成 .env 再改，docker compose 会自动读取
# 首次启动的登录密码（强烈建议改掉，至少 8 位）
ASSETBOOK_PASSWORD=change-me-please

# 会话签名密钥。可留空自动生成；想固定就填一串随机字符：
#   python3 -c "import secrets;print(secrets.token_hex(32))"
ASSETBOOK_SECRET=

# 可选：OpenAI 兼容接口，用于「AI 智能分类」（不填则只用本地关键词规则）
# 例：ASSETBOOK_AI_BASE=https://api.deepseek.com/v1
#     ASSETBOOK_AI_MODEL=deepseek-chat
ASSETBOOK_AI_BASE=
ASSETBOOK_AI_KEY=
ASSETBOOK_AI_MODEL=

# ── 自动同步（行情 / 汇率 / 净值快照）────────────────────────────
# 总开关，1 开 0 关。开起来后每天会自动刷现价、拉汇率、记净值快照，
# 这些设置改了也能在 界面 → 设置 → 自动同步 里随时调，数据库里的优先。
ASSETBOOK_AUTO_SYNC=1
# 行情刷新间隔（分钟），5~1440
ASSETBOOK_QUOTE_INTERVAL_MIN=30
# 每天几点记一次净值快照（0~23 点）
ASSETBOOK_SNAPSHOT_HOUR=23
# 汇率刷新间隔（小时），1~168
ASSETBOOK_RATES_INTERVAL_HOUR=12
